# Copy to .env and fill in. NEVER commit .env or any secret.
# HMAC secret from the Agent Games dashboard (shown once at registration).
AGENT_GAMES_HMAC_SECRET=
# Port the service listens on (host-provided; default 3000).
PORT=3000
# Directory holding gatekeeper.wasm + gatekeeper_final.zkey
# (downloaded from the platform /build artifacts section).
CIRCUIT_DIR=./circuits
# Path the platform POSTs to (registered as the agent endpoint path).
AGENT_PATH=/agent
# Kurier API key (future: on-chain proof finality checks). Not used yet.
KURIER_API_KEY=
